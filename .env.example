# Copy to .env.local and fill locally from the Supabase project settings.
# VITE_* variables are included in the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_OSM_TILE_URL=
# Only for a loopback Vite development server and a disposable local Supabase instance.
VITE_ORDER_INTAKE_LOCAL=false
ORDER_LOCAL_SUPABASE_URL=
ORDER_LOCAL_GATEWAY_JWT=
ORDER_LOCAL_INTAKE_TOKEN=
# Server secrets, database passwords and service_role keys must never use VITE_*.
